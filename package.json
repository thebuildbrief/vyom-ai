{
  "name": "vyom-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix frontend ci --include=dev --no-audit --no-fund",
    "install:all": "npm --prefix frontend ci --include=dev --no-audit --no-fund && npm --prefix backend ci --include=dev --no-audit --no-fund",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "migrate:neon:schema": "npm --prefix backend run migrate:neon:schema",
    "migrate:neon": "npm --prefix backend run migrate:neon",
    "verify:neon": "npm --prefix backend run verify:neon"
  }
}
