# VYOM AI backend environment (Vercel project: backend)
# These values are server-side only. Never add a VITE_ prefix here.
NODE_ENV=development
PORT=4000

# Exact production frontend origin. Comma-separated values are supported.
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Separate Vercel projects are cross-site; set none in production and keep HTTPS.
COOKIE_SAME_SITE=lax
JWT_SECRET=replace-with-at-least-32-random-characters

# Neon PostgreSQL. DATABASE_URL must be the pooled runtime URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PG_POOL_MAX=5
PGSSLMODE=require
# Local SQLite fallback when DATABASE_URL is empty.
DATABASE_PATH=./server/data/vyom.sqlite
UPLOAD_DIR=./server/uploads
SOURCE_SQLITE_PATH=./server/data/vyom.sqlite

# OpenAI-compatible server-side LLM and Realtime voice.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/calls

# JDoodle code execution.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
JDOODLE_CPP_VERSION_INDEX=7
JDOODLE_JAVA_VERSION_INDEX=6
JDOODLE_PYTHON_VERSION_INDEX=6
JDOODLE_JAVASCRIPT_VERSION_INDEX=7

# Resend-compatible email delivery.
MAIL_API_URL=https://api.resend.com
MAIL_API_KEY=
MAIL_FROM=VYOM AI <accounts@example.com>

# Google Identity Services server-side verification.
GOOGLE_CLIENT_ID=

# Vercel private Blob injects BLOB_READ_WRITE_TOKEN when the store is connected.
# With it set on Vercel the Resume page uploads directly to Blob (8 MB);
# without it the multipart fallback is limited to the 4 MB function body size.
# Optional: public origin only (the Blob SDK appends the request path).
# VERCEL_BLOB_CALLBACK_URL=https://your-project.vercel.app
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PATH_STYLE=false

# Optional local OCR executables.
PDFTOPPM_CMD=
TESSERACT_CMD=
TESSERACT_LANG=eng
