{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__api_path=/api/$1" },
    { "source": "/health", "destination": "/api/index.js?__api_path=/api/health" },
    { "source": "/", "destination": "/api/index.js?__api_path=/api/health" }
  ]
}
