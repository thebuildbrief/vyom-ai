# Local development. Omit DATABASE_URL to use SQLite.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=
COOKIE_SAME_SITE=lax
JWT_SECRET=replace-with-at-least-32-random-characters

# Vercel production: Neon PostgreSQL pooled URL for application traffic.
# Use the Neon pooled URL (hostname contains -pooler) as DATABASE_URL.
DATABASE_URL=
# Direct Neon URL for one-time schema/data migration CLI only.
DATABASE_URL_UNPOOLED=
PG_POOL_MAX=5
PGSSLMODE=require
# Local SQLite remains available when DATABASE_URL is not set.
DATABASE_PATH=./server/data/vyom.sqlite

# OpenAI or OpenAI-compatible server-side LLM and Realtime voice.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime/calls

# JDoodle code execution. Keep credentials server-side only.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
# These are versionIndex values and can be pinned to the versions enabled by your JDoodle plan.
JDOODLE_CPP_VERSION_INDEX=7
JDOODLE_JAVA_VERSION_INDEX=6
JDOODLE_PYTHON_VERSION_INDEX=6
JDOODLE_JAVASCRIPT_VERSION_INDEX=7

# Email delivery via Resend-compatible API.
MAIL_API_URL=https://api.resend.com
MAIL_API_KEY=
MAIL_FROM=VYOM AI <accounts@example.com>

# Google Identity Services.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Vercel private Blob adds BLOB_READ_WRITE_TOKEN to the linked deployment automatically.
# Alternatively configure an S3-compatible private bucket:
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PATH_STYLE=false

# Optional OCR executables (typically local development only).
PDFTOPPM_CMD=
TESSERACT_CMD=
TESSERACT_LANG=eng
