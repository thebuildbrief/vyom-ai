# VYOM AI frontend environment (Vercel project: frontend)
# Leave empty for local development so Vite proxies /api to http://localhost:4000.
# In production set this to the backend Vercel project origin, with no trailing slash
# and without /api, for example: https://vyom-ai-api.vercel.app
VITE_API_BASE_URL=

# Public Google OAuth client ID (never a client secret).
VITE_GOOGLE_CLIENT_ID=
